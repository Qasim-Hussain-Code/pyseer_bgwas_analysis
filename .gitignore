# ==============================================================================
# Bacterial GWAS Analysis — .gitignore
# ==============================================================================
# This repository tracks only the reproducible pipeline (scripts, manifests,
# and documentation). All raw data, intermediate results, and large binary
# outputs are excluded and should be regenerated via analysis.sh.
# ==============================================================================

# ---- Raw / downloaded data archives -----------------------------------------
*.tar.bz2
*.zip

# ---- Genome assemblies and sequences ----------------------------------------
/assemblies/
*.fa
*.fasta
*.fna

# ---- Genome annotations -----------------------------------------------------
*.gff
*.gff3

# ---- Variant calls -----------------------------------------------------------
*.vcf
*.vcf.gz
*.vcf.gz.tbi

# ---- Phenotype and gene presence/absence matrices ----------------------------
*.pheno
*.Rtab

# ---- Phylogenetic trees ------------------------------------------------------
*.tree
*.nwk
*.treefile

# ---- Mash distance / sketch outputs -----------------------------------------
*.msh
*.tsv

# ---- Serialised model objects ------------------------------------------------
*.pkl
*.pickle

# ---- Pyseer association results ----------------------------------------------
penicillin_COGs.txt
penicillin_SNPs.txt
penicillin_kmers.txt
significant_kmers.txt
kmer_patterns.txt
lineage_effects.txt

# ---- Phandango / Manhattan plots ---------------------------------------------
*.plot

# ---- Annotation outputs -----------------------------------------------------
annotated_kmers.txt
gene_hits.txt

# ---- K-mer files -------------------------------------------------------------
fsm_kmers.txt.gz

# ---- Figures -----------------------------------------------------------------
*.png
*.pdf
*.svg

# ---- FSM file list (generated from assemblies manifest) ----------------------
fsm_file_list.txt

# ---- Python / system caches --------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# ---- OS artefacts ------------------------------------------------------------
.DS_Store
Thumbs.db

# ---- Editor / IDE ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
